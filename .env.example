MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=smart_parking
MYSQL_PORT=3306

REDIS_PORT=6379

BACKEND_PORT=8080
FRONTEND_PORT=5173

# JWT 密钥（必填）：至少 32 字符的强随机串，例如：openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION=7200
JWT_REFRESH_EXPIRATION=604800
JWT_ISSUER=smart-parking

# CORS 允许的前端来源（逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# 预约过期宽限期（分钟）：arrive_time 超过该时长未入场由定时任务置为 EXPIRED 并释放车位
RESERVATION_EXPIRATION_GRACE_MINUTES=30

BAIDU_OCR_API_KEY=
BAIDU_OCR_SECRET_KEY=
BAIDU_OCR_CONFIDENCE_THRESHOLD=0.8000

# AI 助手：provider 取 rule-based（默认，内置规则引擎）或 openai（OpenAI 兼容接口）
AI_PROVIDER=rule-based
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
AI_MAX_HISTORY_MESSAGES=6
AI_TEMPERATURE=0.3

# Python RAG 服务：将 AI_PROVIDER 设为 python 后，问答请求会转由 ai-service（FastAPI + RAG）回答；
# 该服务不可用或调用失败时，后端会自动降级回 rule-based 规则引擎，rule-based 仍为默认回退。
# Python AI 服务地址：
# - docker compose 部署：保持注释即可，后端容器默认使用服务名 http://ai-service:8000
# - 宿主机直接运行后端：取消注释并使用 http://localhost:8000
# AI_PYTHON_BASE_URL=http://localhost:8000
AI_PYTHON_TIMEOUT_SECONDS=30
AI_SERVICE_PORT=8000
AI_RAG_TOP_K=4
AI_RAG_EMBEDDING_ENABLED=false
