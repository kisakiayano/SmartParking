FROM maven:3.9.9-eclipse-temurin-17 AS build

WORKDIR /workspace

COPY .mvn .mvn
COPY pom.xml pom.xml
COPY backend/pom.xml backend/pom.xml
COPY backend/src backend/src

RUN mvn -pl backend -am -Dmaven.test.skip=true -Dmaven.wagon.http.retryHandler.count=3 package

FROM eclipse-temurin:17-jre-jammy

WORKDIR /app

COPY --from=build /workspace/backend/target/smart-parking-backend-0.0.1-SNAPSHOT.jar app.jar

EXPOSE 8080

ENTRYPOINT ["java", "-jar", "/app/app.jar"]
